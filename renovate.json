{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": { "schedule": ["at any time"], "labels": ["security"] },
  "packageRules": [
    {
      "description": "Group GitHub Actions and automerge non-major updates",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "description": "Automerge npm patch updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge npm devDependency minor updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor"],
      "automerge": true
    },
    {
      "description": "Wait before adopting new PyPI releases",
      "matchManagers": ["pip_requirements"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Automerge pip patch updates",
      "matchManagers": ["pip_requirements"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Never automerge runtime version bumps",
      "matchManagers": ["pyenv", "nodenv"],
      "automerge": false
    }
  ]
}
